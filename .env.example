# Database connection URL (SQLite local file by default)
DATABASE_URL="file:./dev.db"

# Admin Authentication secret key (Generate a strong secret key in production)
ADMIN_AUTH_SECRET="super-secret-admin-token-key-change-in-production-12345"

# Amazon Associates Tag (e.g., storename-20)
AMAZON_ASSOCIATE_TAG="amzfinds-20"

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Amazon Product Advertising API Credentials (Optional - configured when PA-API access is available)
# AMAZON_API_KEY=""
# AMAZON_API_SECRET=""
